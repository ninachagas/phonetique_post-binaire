# Prefix: Languagesystems
# automatic
languagesystem DFLT dflt;

languagesystem latn dflt;
languagesystem latn CAT;

feature aalt {
# automatic
feature case;
feature locl;
} aalt;

feature case {
script DFLT;
language dflt;
lookup SUB_30 {
	sub periodcentered by periodcentered.case;
} SUB_30;
lookup SUB_31 {
	sub I periodcentered E by uF2610;
	sub M periodcentered P by uF3410;
	sub P periodcentered M by uF3410;
} SUB_31;
script latn;
language dflt;
lookup SUB_30;
lookup SUB_31;
language CAT;
lookup SUB_30;
lookup SUB_31;
} case;

feature locl {
lookup locl_latn_0 {
	script latn;
	language CAT;
	sub  l' periodcentered' l by ldot;
	sub  L' periodcentered' L by Ldot;
} locl_latn_0;
} locl;

