 GlyphClassDef ,# Base 
 [A_E A_O E_A Eacute_E I_E N_E N_E_S R_S_E T_E T_E_S U_E a_o c_h d_e e_a e_s e_u eacute_e f_e f_v i_e l_e l_l l_u n_e n_e_s n_n n_n_e n_n_e_s r_e r_i r_s r_s_e s_e s_t s_t_e t_e u_e u_l u_l_l u_l_l_e x_l x_l_e x_l_l x_l_l_e x_s x_s_e x_s_e_s f_b.liga f_f.liga f_f_b.liga f_f_h.liga f_f_i.liga f_f_j.liga f_f_k.liga f_f_l.liga f_h.liga f_i.liga f_j.liga f_k.liga f_l.liga], # Liga 
