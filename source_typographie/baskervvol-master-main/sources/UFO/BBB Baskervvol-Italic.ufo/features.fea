	sub f j by f_j.liga;
	sub f k by f_k.liga;
	sub f t by f_t.liga;
	sub t t by t_t.liga;
	sub f i by fi;
	sub f l by fl;
} ligaturesstandards;

lookup point {
    sub period period by periodcentered;
    sub period period period by ellipsis;
	sub periodcentered period by ellipsis;
} point;

sub @Uppercase periodcentered' by periodcentered.case;
sub periodcentered' @Uppercase by periodcentered.case;

